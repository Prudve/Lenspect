  background: #ffffff;
  padding: 0.1rem 0.35rem;
  border-radius: 4px;
  border: 1px solid #e2e8f0;
  color: #0f172a;
}

/* Portal Footer */
.login-footer {
  background: #f8fafc;
  padding: 0.9rem 1.5rem;
  border-top: 1px solid #e2e8f0;
  text-align: center;
  font-size: 0.75rem;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
}

@keyframes shake {
